{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "strict": true,
    "jsx": "react-jsx", "jsxImportSource": "preact", "noEmit": true,
    "allowImportingTsExtensions": true, "verbatimModuleSyntax": true,
    "skipLibCheck": true, "erasableSyntaxOnly": true,
    "paths": { "@protocolo": ["./servidor/protocolo.ts"] }
  },
  "include": ["servidor", "web", "pruebas", "vite.config.ts"]
}
