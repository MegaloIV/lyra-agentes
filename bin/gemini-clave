#!/usr/bin/env bash
# Guarda la clave de API de Google AI Studio para Gemini CLI en ~/.gemini/.env (solo tú puedes leerlo).
# Gemini CLI ya no acepta iniciar sesión con una cuenta personal de Google; la clave es gratis.
# Lyra lo abre en una terminal desde «Poner la clave»; la clave la pegas tú y no se muestra.
set -euo pipefail
archivo="$HOME/.gemini/.env"
xdg-open 'https://aistudio.google.com/apikey' >/dev/null 2>&1 &
echo 'Gemini con clave de API de Google AI Studio (es gratis)'
echo
echo '1. En el navegador que se abrió, pulsa «Create API key» (o «Crear clave de API») y cópiala.'
printf '2. Pégala aquí (no se verá) y pulsa Enter: '
IFS= read -rs clave; echo
clave=$(printf '%s' "$clave" | tr -d '[:space:]')
if [ -z "$clave" ]; then echo 'No pegaste nada; no se cambió nada.'; read -r _; exit 1; fi
mkdir -p "$HOME/.gemini"
umask 077
touch "$archivo"
{ grep -v '^\s*\(export\s\+\)\?GEMINI_API_KEY\s*=' "$archivo" || true; printf 'GEMINI_API_KEY=%s\n' "$clave"; } > "$archivo.nuevo"
mv "$archivo.nuevo" "$archivo"
chmod 600 "$archivo"
# Que Gemini CLI use la clave y no la sesión de Google que dejó guardada (Google ya no la acepta)
node -e '
const fs = require("fs"), f = process.argv[1];
let a = {}; try { a = JSON.parse(fs.readFileSync(f, "utf8")); } catch {}
a.security ??= {}; a.security.auth ??= {}; a.security.auth.selectedType = "gemini-api-key";
fs.writeFileSync(f, JSON.stringify(a, null, 2) + "\n");' "$HOME/.gemini/settings.json"
echo
echo "Listo: quedó en $archivo. Ya puedes cerrar esta ventana y crear un agente de Gemini en Lyra."
read -r _
